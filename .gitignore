# runtime state — personal data, tokens, caches
state/

# python
__pycache__/
*.pyc

# macOS / other tools
.DS_Store
.bkit/

# never track runtime json at root either
/*.json
/*.pid
/*.bin

!config.example.json

# extra cats (e.g. cat packs) — only the original cat ships with the repo
assets/pets/*
!assets/pets/sprout/
